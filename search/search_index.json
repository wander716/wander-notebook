4e1a\u7b14\u8bb0 - \u8bb0\u5f55\u8bfe\u5802\u63a8\u5bfc\u4e0e\u516c\u5f0f\u6574\u7406</li> <li>\ud83d\udcbb \u7f16\u7a0b\u4e0e\u5de5\u5177 - \u5e38\u7528\u4ee3\u7801\u7247\u6bb5\u4e0e\u6392\u7248\u6280\u5de7</li> </ul>"},{"location":"notes-acee/Information%20Theory/","title":"\u4fe1\u606f\u7406\u8bba","text":"Python (NumPy) <pre><code>import numpy as np\n# \u4eff\u771f\u4ee3\u7801\u7247\u6bb5\n</code></pre> MATLAB <pre><code>% \u6570\u636e\u5904\u7406\u4e0e\u53ef\u89c6\u5316\nplot(x, y)\n</code></pre> LaTeX <pre><code>\\begin{equation}\nE = mc^2\n\\end{equation}\n</code></pre> <p>\u6838\u5fc3\u7ed3\u8bba</p> <p>\u8fd9\u662f\u672c\u7ae0\u7684\u91cd\u70b9\u516c\u5f0f\uff0c\u5fc5\u987b\u638c\u63e1\u3002</p> \u70b9\u51fb\u5c55\u5f00\uff1a\u8be6\u7ec6\u7684\u516c\u5f0f\u63a8\u5bfc\u8fc7\u7a0b <p>\u8fd9\u91cc\u53ef\u4ee5\u653e\u590d\u6742\u7684\u6b65\u9aa4\u6216\u63a8\u5bfc...</p> \u4eff\u771f\u907f\u5751\u6307\u5357 <p>\u8bb0\u5f55\u4e0a\u6b21\u62a5\u9519\u7684\u89e3\u51b3\u65b9\u6848...</p>"},{"location":"notes-ee/","title":"Index","text":"Electronics Engineering <p>     \u4fe1\u606f\u5de5\u7a0b\u4e13\u4e1a\uff1a\u7535\u5b50\u7535\u8def\u57fa\u7840\u7b49\u6838\u5fc3\u786c\u4ef6\u8bfe\u7a0b\u7684\u5b66\u4e60\u7b14\u8bb0\u4e0e\u4eff\u771f\u590d\u76d8\u3002   </p>"},{"location":"notes-ee/#_1","title":"\ud83d\ude80 \u5b66\u4e60\u8def\u7ebf","text":"<p>\u5728\u8fd9\u91cc\u53ef\u4ee5\u5f00\u59cb\u5199\u60a8\u7684\u5177\u4f53\u5185\u5bb9...</p>"},{"location":"notes-ee/Fundamentals%20of%20EE%20Circuits/","title":"\u7535\u5b50\u7535\u8def\u57fa\u7840","text":"<p>\u8bfe\u5802\u7b14\u8bb0\u3001\u6574\u7406\u7684\u9898\u96c6\u3001\u6559\u6750\u53ca\u8bfe\u4ef6\u3001\u4f5c\u4e1a\u9898\u7b54\u6848\u3001\u671f\u4e2d\u3001\u671f\u672b\u5386\u5e74\u5377\u7b49\u8be6\u60c5\u8bf7\u89c1\uff1ahttps://github.com/wander716/EE/tree/main/%E7%94%B5%E5%9F%BA</p>"}]}