{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u9996\u9875","text":""},{"location":"#_1","title":"\u6b22\u8fce\u6765\u5230\u6211\u7684\u4e3b\u9875","text":"<p>\u4f60\u597d\uff01\u8fd9\u91cc\u662f\u6211\u7684\u4e2a\u4eba\u77e5\u8bc6\u5e93\u3002\u6211\u76ee\u524d\u4e3b\u4fee\u4fe1\u606f\u5de5\u7a0b\uff0c\u5728\u8fd9\u91cc\u6211\u4f1a\u6c89\u6dc0\u6211\u7684\u4e13\u4e1a\u5b66\u4e60\u7b14\u8bb0\u3001\u9879\u76ee\u590d\u76d8\u4ee5\u53ca\u4e00\u4e9b\u6280\u672f\u63a2\u7d22\u3002</p> <p>\u5173\u4e8e\u672c\u7ad9</p> <p>\u672c\u7ad9\u4e3b\u8981\u7528\u4e8e\u8bb0\u5f55\u548c\u5206\u4eab\u3002\u56e0\u4e3a\u5e73\u65f6\u6d89\u53ca\u8f83\u591a\u516c\u5f0f\u63a8\u5bfc\u548c\u4ee3\u7801\u4eff\u771f\uff0c\u8fd9\u91cc\u7279\u522b\u914d\u7f6e\u4e86\u5bf9 LaTeX \u516c\u5f0f\u548c\u4ee3\u7801\u9ad8\u4eae\u7684\u5168\u9762\u652f\u6301\u3002</p>"},{"location":"#_2","title":"\ud83d\ude80 \u6700\u8fd1\u66f4\u65b0 (\u5f85\u8865\u5145)","text":"<ul> <li>[2026-03] \u66f4\u65b0\u4e86\u5173\u4e8e\u65e0\u7ebf\u901a\u4fe1\u57fa\u7840\u6982\u5ff5\u7684\u5b66\u4e60\u7b14\u8bb0\u3002</li> <li>[2026-02] \u8865\u5145\u4e86\u201c\u592a\u7a7a\u7535\u68af\u4e0e\u6708\u7403\u57fa\u5730\u5efa\u8bbe\u201d\u6570\u5b66\u5efa\u6a21\u9879\u76ee\u7684 MATLAB \u4eff\u771f\u6570\u636e\u3002</li> <li>[2026-01] \u6574\u7406\u4e86\u6a21\u62df\u7535\u5b50\u6280\u672f\u4e0e\u5927\u5b66\u7269\u7406\u7684\u671f\u672b\u590d\u4e60\u6846\u67b6\u3002</li> </ul>"},{"location":"#_3","title":"\ud83d\udcc2 \u5feb\u901f\u5bfc\u822a","text":"<ul> <li>\ud83d\udcc4 \u4e2a\u4eba\u7b80\u5386 - \u6211\u7684\u6559\u80b2\u80cc\u666f\u4e0e\u9879\u76ee\u7ecf\u5386</li> <li>\ud83d\udcd0 \u4e13\u4e1a\u7b14\u8bb0 - \u8bb0\u5f55\u8bfe\u5802\u63a8\u5bfc\u4e0e\u516c\u5f0f\u6574\u7406</li> <li>\ud83d\udcbb \u7f16\u7a0b\u4e0e\u5de5\u5177 - \u5e38\u7528\u4ee3\u7801\u7247\u6bb5\u4e0e\u6392\u7248\u6280\u5de7</li> </ul>"}]}